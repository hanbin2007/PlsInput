    },
    "Skip": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过"
          }
        }
      }
    },
    "Slot selected. Press a key to overwrite it, or tap it again to deselect.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选中格子。按键覆盖它，或再点一次取消。"
          }
        }
      }
    },
    "Slot types": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "格子类型"
          }
        }
      }
    },
    "Slot types: Stable never rots. Echo copies the slot two to its left. Amp doubles a digit. Rotten rots fast but costs no durability.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "格子类型：稳定格不腐烂；回声格复制左边第二格；增幅格数字翻倍；烂格腐烂快但填它不耗耐久。"
          }
        }
      }
    },
    "Slots and keys": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "格子与键"
          }
        }
      }
    },
    "Slots are full. Tap a slot, then press a key to overwrite it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "格子满了。点一个格子，再按键覆盖它。"
          }
        }
      }
    },
    "Stable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稳定格"
          }
        }
      }
    },
