          "stringUnit": {
            "state": "translated",
            "value": "练习成绩"
          }
        }
      }
    },
    "Press 9.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下 9。"
          }
        }
      }
    },
    "Press a key to fill the next empty slot. Tap a filled slot, then press a key to overwrite it. Long-press to clear. Adjacent digits join into one number.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键填进下一个空格。点已填的格子再按键就是覆盖。长按清空。相邻数字会连成一个数。"
          }
        }
      }
    },
    "Random puzzles, unlimited tries, no ranking.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随机题，不限次数，不计排名。"
          }
        }
      }
    },
    "Rank": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
